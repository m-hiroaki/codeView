<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeView.Presentation"
        xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="CodeView.Presentation.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="codeView" Width="1180" Height="800" MinWidth="680" MinHeight="460"
        Background="#14181F">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Menu Background="#191E26">
            <MenuItem Header="ファイル">
                <MenuItem x:Name="OpenMenu" Header="ファイルを開く…" Click="OpenClicked" />
                <MenuItem Header="フォルダを開く…" Click="OpenFolderClicked" />
                <MenuItem Header="フォルダを再読み込み" IsEnabled="{Binding HasWorkspace}" Click="RefreshWorkspaceClicked" />
                <MenuItem Header="フォルダを閉じる" IsEnabled="{Binding HasWorkspace}" Click="CloseWorkspaceClicked" />
                <Separator />
                <MenuItem Header="再読み込み" IsEnabled="{Binding CanReload}" Click="ReloadClicked" />
                <MenuItem Header="文字コードを指定して開き直す" IsEnabled="{Binding CanReopenEncoding}">
                    <MenuItem Header="自動判定" Tag="Auto" Click="EncodingClicked" />
                    <MenuItem Header="UTF-8" Tag="Utf8" Click="EncodingClicked" />
                    <MenuItem Header="Shift_JIS（CP932）" Tag="Cp932" Click="EncodingClicked" />
                    <MenuItem Header="UTF-16 LE" Tag="Utf16Le" Click="EncodingClicked" />
                    <MenuItem Header="UTF-16 BE" Tag="Utf16Be" Click="EncodingClicked" />
                    <MenuItem Header="UTF-32 LE" Tag="Utf32Le" Click="EncodingClicked" />
                    <MenuItem Header="UTF-32 BE" Tag="Utf32Be" Click="EncodingClicked" />
                </MenuItem>
                <MenuItem x:Name="CloseMenu" Header="タブを閉じる" IsEnabled="{Binding HasTabs}" Click="CloseFileClicked" />
                <Separator />
                <MenuItem Header="終了" Click="ExitClicked" />
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="ファイルツリー" ToggleType="CheckBox" IsChecked="{Binding IsTreeVisible, Mode=TwoWay}" IsEnabled="{Binding HasWorkspace}" />
                <MenuItem Header="検索結果パネル" ToggleType="CheckBox" IsChecked="{Binding SearchPanel.IsVisible, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="検索">
                <MenuItem x:Name="WorkspaceSearchMenu" Header="フォルダを検索…" IsEnabled="{Binding CanSearchWorkspace}" Click="ShowSearchClicked" />
                <MenuItem x:Name="FindDefinitionsMenu" Header="定義へジャンプ（簡易）" IsEnabled="{Binding HasDocument}" Click="FindDefinitionsClicked" />
                <MenuItem x:Name="FindReferencesMenu" Header="参照を検索（名前一致）" IsEnabled="{Binding HasDocument}" Click="FindReferencesClicked" />
                <MenuItem Header="検索を取り消す" IsEnabled="{Binding SearchPanel.IsRunning}" Click="CancelSearchClicked" />
            </MenuItem>
        </Menu>
        <Border Grid.Row="1" Background="#202630" Padding="14,9">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasWorkspace}">
                    <TextBlock Text="{Binding WorkspaceSummary}" Foreground="#94D4C3" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspacePath}" TextTrimming="CharacterEllipsis" Foreground="#A9B9CD" />
                </Grid>
                <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Foreground="#BDC8D7" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <Border Width="280" Background="#191E26" BorderBrush="#303A48" BorderThickness="0,0,1,0" IsVisible="{Binding IsTreeVisible}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Margin="12,8" ColumnDefinitions="*,Auto">
                        <TextBlock Text="ファイル" FontSize="12" Foreground="#A9B9CD" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="再読込" FontSize="11" Padding="7,3" Click="RefreshTreeClicked" ToolTip.Tip="選択フォルダを再読込（F5）。未選択ならルートを再読込" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding FileTree.Notice}" TextWrapping="Wrap" Margin="10,0,10,3" FontSize="11" Foreground="#E6C88C" />
                    <ListBox Grid.Row="2" x:Name="FileTreeList" ItemsSource="{Binding FileTree.Rows}"
                             SelectedItem="{Binding FileTree.SelectedRow, Mode=TwoWay}" SelectionMode="Single"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             DoubleTapped="TreeDoubleTapped" KeyDown="TreeKeyDown" AutomationProperties.Name="ファイルツリー">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileTreeRow">
                                <Grid ColumnDefinitions="24,*,Auto" Height="28" Margin="{Binding Indent}" ToolTip.Tip="{Binding Path}" AutomationProperties.Name="{Binding AccessibleName}">
                                    <Button Content="{Binding Disclosure}" IsEnabled="{Binding CanExpand}" Click="TreeDisclosureClicked"
                                            Focusable="False" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#94D4C3"
                                            AutomationProperties.Name="展開または折りたたみ" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="#CBD3DF" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="#A9B9CD" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <ListBox x:Name="TabList" Height="48" IsVisible="{Binding HasTabs}" ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}" SelectionMode="Single"
                         SelectionChanged="TabSelectionChanged"
                         Background="#202630" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="開いているファイル">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,3" /></Style></ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto" ToolTip.Tip="{Binding FullPath}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="6,0" Foreground="#E6C88C" FontSize="10" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="×" Click="CloseTabClicked" Focusable="False" Background="Transparent" BorderThickness="0" Padding="4,0" AutomationProperties.Name="タブを閉じる" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        <editor:TextEditor Grid.Row="1" x:Name="Editor"
                           Document="{Binding Document}" IsReadOnly="True" ShowLineNumbers="True"
                           WordWrap="False" FontFamily="Menlo,Consolas,monospace" FontSize="14"
                           Background="#14181F" Foreground="#CBD3DF" LineNumbersForeground="#718198"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <editor:TextEditor.Options>
                <editor:TextEditorOptions EnableHyperlinks="False" EnableEmailHyperlinks="False" EnableTextDragDrop="False" />
            </editor:TextEditor.Options>
        </editor:TextEditor>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !HasDocument}">
            <TextBlock Text="codeView" FontSize="28" Foreground="#94D4C3" HorizontalAlignment="Center" />
            <Button Content="ファイルを開く" Click="OpenClicked" HorizontalAlignment="Center" />
        </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Height="280" Background="#191E26" BorderBrush="#303A48" BorderThickness="0,1,0,0"
                IsVisible="{Binding SearchPanel.IsVisible}" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <TextBlock Text="フォルダ検索" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94D4C3" />
                    <TextBox x:Name="SearchQuery" Grid.Column="1" Text="{Binding SearchPanel.Query, Mode=TwoWay}" PlaceholderText="検索語（前後の空白も検索）"
                             AutomationProperties.Name="フォルダ検索の検索語" MinWidth="120" />
                    <Button Grid.Column="2" Content="検索" Click="StartSearchClicked" IsEnabled="{Binding SearchPanel.CanStart}" Margin="6,0,0,0" />
                    <Button Grid.Column="3" Content="取消" Click="CancelSearchClicked" IsEnabled="{Binding SearchPanel.IsRunning}" Margin="6,0,0,0" />
                    <Button Grid.Column="4" Content="クリア" Click="ClearSearchClicked" Margin="6,0,0,0" />
                    <Button Grid.Column="5" Content="×" Click="HideSearchClicked" Margin="6,0,0,0" ToolTip.Tip="パネルを隠す（検索は継続）" AutomationProperties.Name="検索パネルを隠す" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                    <CheckBox Content="大小文字を区別" IsChecked="{Binding SearchPanel.MatchCase, Mode=TwoWay}" />
                    <CheckBox Content="単語単位" IsChecked="{Binding SearchPanel.WholeWord, Mode=TwoWay}" />
                    <CheckBox Content="正規表現" IsChecked="{Binding SearchPanel.UseRegex, Mode=TwoWay}" />
                    <TextBlock Text="正規化なし" VerticalAlignment="Center" FontSize="10" Foreground="#A9B9CD" ToolTip.Tip="Unicode結合文字の正規化や幅の同一視は行いません。" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="2" Margin="0,3,0,5">
                    <TextBlock Text="行単位・1行1,048,576 UTF-16単位まで。超過行は未評価。1行の照合が100ms超で検索中断。" IsVisible="{Binding SearchPanel.UseRegex}" Foreground="#E6C88C" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock x:Name="SearchDescription" Text="{Binding SearchPanel.Description}" Foreground="#94D4C3" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SearchPanel.Summary}" Foreground="#CBD3DF" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SearchPanel.Progress}" Foreground="#A9B9CD" FontSize="10" />
                </StackPanel>
                <ListBox x:Name="SearchResultsList" Grid.Row="3" ItemsSource="{Binding SearchPanel.Rows}" SelectedItem="{Binding SearchPanel.SelectedRow, Mode=TwoWay}"
                         DoubleTapped="SearchResultDoubleTapped"
                         Background="#14181F" BorderThickness="0" Padding="0" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="フォルダ検索結果">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultRow">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Height="42" ToolTip.Tip="{Binding FullPath}" AutomationProperties.Name="{Binding Location}">
                                <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" Foreground="#A9B9CD" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding File.Status}" Foreground="#E6C88C" FontSize="10" Margin="10,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis" FontFamily="Menlo,Consolas,monospace" FontSize="12" Foreground="#CBD3DF">
                                    <Run Text="{Binding Before}" /><Run Text="{Binding Match}" Foreground="#94D4C3" FontWeight="Bold" /><Run Text="{Binding After}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border Grid.Row="4" Background="#191E26" Padding="12,5">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#A9B9CD" />
        </Border>
        <Border Grid.Row="5" Background="#202A31" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="読み取り専用" FontSize="11" Foreground="#B0D8C9" />
                <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="11" Margin="0,0,20,0" />
                <Button Grid.Column="2" Content="{Binding EncodingLabel}" FontSize="11" Padding="6,1"
                        IsEnabled="{Binding CanReopenEncoding}" ToolTip.Tip="文字コードを指定して開き直す">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuItem Header="自動判定" Tag="Auto" Click="EncodingClicked" />
                            <MenuItem Header="UTF-8" Tag="Utf8" Click="EncodingClicked" />
                            <MenuItem Header="Shift_JIS（CP932）" Tag="Cp932" Click="EncodingClicked" />
                            <MenuItem Header="UTF-16 LE" Tag="Utf16Le" Click="EncodingClicked" />
                            <MenuItem Header="UTF-16 BE" Tag="Utf16Be" Click="EncodingClicked" />
                            <MenuItem Header="UTF-32 LE" Tag="Utf32Le" Click="EncodingClicked" />
                            <MenuItem Header="UTF-32 BE" Tag="Utf32Be" Click="EncodingClicked" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
