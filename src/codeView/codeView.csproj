<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>CodeView</RootNamespace>
        <AssemblyName>codeView</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <PropertyGroup Condition="'$(CodeViewPerformanceProbe)' == 'true'">
        <DefineConstants>$(DefineConstants);CODEVIEW_PERFORMANCE_PROBE</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(CodeViewPerformanceProbe)' == 'true'">
        <Compile Include="../../tests/GuiProbe/*.cs" Link="PerformanceProbe/%(Filename)%(Extension)" />
        <Compile Include="../../tests/codeView.Tests/Performance/ProcessMemory.cs" Link="PerformanceProbe/ProcessMemory.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
        <InternalsVisibleTo Include="codeView.Tests" />
    </ItemGroup>
    <Target Name="IncludePublishNotices" AfterTargets="ComputeFilesToPublish"
            Condition="'$(PublishAot)' == 'true'">
        <ItemGroup>
            <CoreRuntimePack Include="@(ResolvedRuntimePack)"
                             Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'
                                 And '%(ResolvedRuntimePack.RuntimeIdentifier)' == '$(RuntimeIdentifier)'" />
            <RuntimeNotice Include="@(CoreRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" />
            <RuntimeNotice Include="$(RuntimePackagePath)/THIRD-PARTY-NOTICES.TXT" />
            <ResolvedFileToPublish Include="@(RuntimeNotice)">
                <RelativePath>licenses/dotnet/%(RuntimeNotice.Filename)%(RuntimeNotice.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <NativeNoticePackage Include="@(NativeCopyLocalItems)"
                                 Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'SkiaSharp.NativeAssets.macOS'
                                     Or '%(NativeCopyLocalItems.NuGetPackageId)' == 'SkiaSharp.NativeAssets.Win32'
                                     Or '%(NativeCopyLocalItems.NuGetPackageId)' == 'HarfBuzzSharp.NativeAssets.macOS'
                                     Or '%(NativeCopyLocalItems.NuGetPackageId)' == 'HarfBuzzSharp.NativeAssets.Win32'
                                     Or '%(NativeCopyLocalItems.NuGetPackageId)' == 'Onigwrap'
                                     Or '%(NativeCopyLocalItems.NuGetPackageId)' == 'Avalonia.Angle.Windows.Natives'">
                <!-- These packages store the selected native assets under runtimes/<rid>/native. -->
                <PackageRoot>$([System.IO.Path]::GetFullPath('%(RootDir)%(Directory)../../..'))</PackageRoot>
            </NativeNoticePackage>
            <NativeNotice Include="@(NativeNoticePackage->'%(PackageRoot)/LICENSE.txt')"
                          Condition="'%(NativeNoticePackage.NuGetPackageId)' != 'Onigwrap'
                              And '%(NativeNoticePackage.NuGetPackageId)' != 'Avalonia.Angle.Windows.Natives'" />
            <NativeNotice Include="@(NativeNoticePackage->'%(PackageRoot)/THIRD-PARTY-NOTICES.txt')"
                          Condition="'%(NativeNoticePackage.NuGetPackageId)' != 'Onigwrap'
                              And '%(NativeNoticePackage.NuGetPackageId)' != 'Avalonia.Angle.Windows.Natives'" />
            <NativeNotice Include="@(NativeNoticePackage->'%(PackageRoot)/THIRD-PARTY-NOTICES.TXT')"
                          Condition="'%(NativeNoticePackage.NuGetPackageId)' == 'Onigwrap'" />
            <NativeNotice Include="@(NativeNoticePackage->'%(PackageRoot)/LICENSE')"
                          Condition="'%(NativeNoticePackage.NuGetPackageId)' == 'Avalonia.Angle.Windows.Natives'" />
            <ResolvedFileToPublish Include="@(NativeNotice->Distinct())">
                <RelativePath>licenses/%(NativeNotice.NuGetPackageId)/%(NativeNotice.Filename)%(NativeNotice.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
        <Error Condition="'@(CoreRuntimePack)' == '' Or '$(RuntimePackagePath)' == ''"
               Text="Could not resolve the runtime packs for the .NET license and notices." />
    </Target>
</Project>
